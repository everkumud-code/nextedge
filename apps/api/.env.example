WA_API_KEY=
WA_TEMPLATE_NOTICE=cc_notice
WA_TEMPLATE_FEE=cc_fee_due
WA_TEMPLATE_RECEIPT=cc_receipt
RAZORPAY_KEY_ID=                      # online fee payments
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_ENDPOINT=                          # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_BUCKET=coaching-connect
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
CHAT_BANNED_WORDS=                    # comma-separated

# --- Email OTP (free with Gmail: enable 2-step verification, create an App Password) ---
